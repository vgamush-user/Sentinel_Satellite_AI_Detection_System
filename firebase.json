{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api" // Replace "api" with the actual name of your Cloud Function
      },
      {
        "source": "**",
        "destination": "/index.html" // Ensures your SPA client-side routing continues to work
      }
    ]
  }
}
